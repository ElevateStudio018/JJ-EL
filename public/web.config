<?xml version="1.0" encoding="UTF-8"?>
<!--
  JJ El & Entreprenad AB – inställningar för Windows-webbhotellet (IIS).
  Bara grundinställningar som brukar vara tillåtna på delade webbhotell.
  Om sajten visar "500 – Internal Server Error" efter uppladdning: ta bort den här filen
  och be internet.se om hjälp med den del som är låst.
-->
<configuration>
  <system.webServer>
    <!-- index.html före eventuella gamla index.php/default.aspx som ligger kvar i mappen -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Strict-Transport-Security" value="max-age=63072000" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://eeasibbhydlpoaomjwsn.supabase.co https://images.pexels.com; font-src 'self'; connect-src 'self' https://eeasibbhydlpoaomjwsn.supabase.co wss://eeasibbhydlpoaomjwsn.supabase.co https://formsubmit.co; frame-src 'self' https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co; frame-ancestors 'self'; upgrade-insecure-requests" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Filer med hash i namnet ändras aldrig – cacha i ett år. Övriga bilder i 30 dagar. -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <!-- Optimerade bilder har innehållets hash i namnet – cacha i ett år. -->
  <location path="images/opt">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
