# Kopiera till .env.deploy (som git ignorerar) och fyll i uppgifterna från internet.se.
# Den här exempelfilen får INTE innehålla riktiga uppgifter.

# sftp (helst) eller ftps (FTP med TLS). Okrypterad ftp vägras.
DEPLOY_PROTOCOL=sftp
DEPLOY_HOST=
# Lämna tomt för standard (22 för sftp, 21 för ftps)
DEPLOY_PORT=
DEPLOY_USER=
DEPLOY_PASSWORD=
# Mappen på servern som jjel.se visar, t.ex. /public_html eller /www
DEPLOY_PATH=/
# Bara för sftp: serverns nyckel. Skriptet skriver ut den vid första anslutningen.
DEPLOY_SFTP_FINGERPRINT=
